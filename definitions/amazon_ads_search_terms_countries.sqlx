config {
  type: "table",
  schema: "dataform",
  tags: ["auto-cleaning"],
  description: "Amazon Ads search terms enriched with standardized country dimension master attributes.",
  columns: {
    amazon_ads_search_term_sk: "Surrogate key for the search term record.",
    date: "Date of the search term performance data.",
    campaign_id: "Unique identifier for the campaign.",
    campaign_name: "Name of the campaign.",
    campaign_budget_currency_code: "Currency code for the campaign budget.",
    country_code: "ISO country code from advertising data.",
    country_sk: "Surrogate key from the central country dimension.",
    country_name: "Standardized country name from dim_countries.",
    campaign_type: "Type of campaign (e.g., sponsored_products_search_term, sponsored_brands_search_term).",
    ad_group_id: "Unique identifier for the ad group.",
    ad_group_name: "Name of the ad group.",
    keyword_id: "Unique identifier for the keyword.",
    keyword: "The keyword text.",
    keyword_type: "Type of keyword targeting.",
    match_type: "Match type of the keyword.",
    search_term: "The actual customer search query.",
    targeting: "Targeting expression.",
    keyword_text: "Targeting keyword text.",
    keyword_bid: "Bid amount for the keyword.",
    ad_keyword_status: "Status of the ad keyword.",
    cost: "Total cost.",
    spend: "Total advertising spend.",
    impressions: "Number of impressions.",
    clicks: "Number of clicks.",
    viewable_impressions: "Number of viewable impressions.",
    viewability_rate: "Viewability rate.",
    view_click_through_rate: "View click-through rate.",
    sales_1d: "Sales attributed within 1 day.",
    purchases_1d: "Purchases within 1 day.",
    units_sold_clicks_1d: "Units sold from clicks within 1 day.",
    attributed_sales_same_sku_1d: "Sales of the same SKU within 1 day.",
    purchases_same_sku_1d: "Purchases of the same SKU within 1 day.",
    units_sold_same_sku_1d: "Units sold of the same SKU within 1 day.",
    sales_7d: "Sales attributed within 7 days.",
    purchases_7d: "Purchases within 7 days.",
    units_sold_clicks_7d: "Units sold from clicks within 7 days.",
    attributed_sales_same_sku_7d: "Sales of the same SKU within 7 days.",
    purchases_same_sku_7d: "Purchases of the same SKU within 7 days.",
    units_sold_same_sku_7d: "Units sold of the same SKU within 7 days.",
    units_sold_other_sku_7d: "Units sold of other SKUs within 7 days.",
    sales_other_sku_7d: "Sales of other SKUs within 7 days.",
    roas_clicks_7d: "Return on ad spend from clicks within 7 days.",
    sales_14d: "Sales attributed within 14 days.",
    purchases_14d: "Purchases within 14 days.",
    units_sold_clicks_14d: "Units sold from clicks within 14 days.",
    attributed_sales_same_sku_14d: "Sales of the same SKU within 14 days.",
    purchases_same_sku_14d: "Purchases of the same SKU within 14 days.",
    units_sold_same_sku_14d: "Units sold of the same SKU within 14 days.",
    roas_clicks_14d: "Return on ad spend from clicks within 14 days.",
    sales_30d: "Sales attributed within 30 days.",
    purchases_30d: "Purchases within 30 days.",
    units_sold_clicks_30d: "Units sold from clicks within 30 days.",
    attributed_sales_same_sku_30d: "Sales of the same SKU within 30 days.",
    purchases_same_sku_30d: "Purchases of the same SKU within 30 days.",
    units_sold_same_sku_30d: "Units sold of the same SKU within 30 days.",
    sales: "Total sales.",
    purchases: "Total purchases.",
    units_sold: "Total units sold.",
    sales_clicks: "Sales from clicks.",
    purchases_clicks: "Purchases from clicks.",
    video_complete_views: "Number of video complete views.",
    video_5_second_views: "Number of 5-second video views.",
    video_5_second_view_rate: "5-second video view rate.",
    video_first_quartile_views: "First quartile video views.",
    video_midpoint_views: "Midpoint video views.",
    video_third_quartile_views: "Third quartile video views.",
    video_unmutes: "Number of video unmutes.",
    add_to_list: "Number of times added to list.",
    add_to_list_from_clicks: "Added to list from clicks.",
    qualified_borrows: "Number of qualified borrows.",
    qualified_borrows_from_clicks: "Qualified borrows from clicks.",
    royalty_qualified_borrows: "Number of royalty qualified borrows.",
    royalty_qualified_borrows_from_clicks: "Royalty qualified borrows from clicks.",
    kindle_edition_normalized_pages_read_14d: "Kindle edition normalized pages read within 14 days.",
    kindle_edition_normalized_pages_royalties_14d: "Kindle edition royalties within 14 days.",
    campaign_budget_amount: "Campaign budget amount.",
    campaign_budget_type: "Campaign budget type.",
    campaign_status: "Campaign status.",
    cost_type: "Cost type.",
    report_period: "Reporting period.",
    updated_at: "Timestamp when the record was last updated.",
    division: "Division derived from campaign name.",
    product: "Product category derived from campaign name.",
    campaign_name_cleaned: "Cleaned campaign name.",
    campaign_type_cleaned: "Cleaned campaign type.",
    budget: "Budget type.",
    format: "Format derived from campaign name.",
    ad_type: "Ad type derived from campaign name.",
    _processed_at: "Timestamp when the record was processed.",
    market: "Market derived from campaign name.",
    company_code: "Company code for mapped country_code.",
    date_currency: "Date when exchange rate is valid.",
    exchange_rate: "Exchange rate from source to target currency.",
    cost_local: "Total cost in local currency.",
    spend_local: "Total spend in local currency.",
    campaign_budget_local: "Campaign budget in local currency.",
    cost_eur: "Total cost in EUR.",
    spend_eur: "Total spend in EUR.",
    campaign_budget_eur: "Campaign budget in EUR."
  },
  metadata: {
    overview: "This table combines Amazon Ads search terms enriched performance facts with standardized country dimension master data from dim_countries.",
    extraProperties: {
      generic: {
        type: "fact table",
        system: "marketing"
      }
    }
  }
}

SELECT
  TRIM(ads.amazon_ads_search_term_sk) AS amazon_ads_search_term_sk,
  ads.date,
  ads.campaign_id,
  TRIM(ads.campaign_name) AS campaign_name,
  TRIM(ads.campaign_budget_currency_code) AS campaign_budget_currency_code,
  TRIM(ads.country_code) AS country_code,
  TRIM(c.country_sk) AS country_sk,
  TRIM(c.country) AS country_name,
  TRIM(ads.campaign_type) AS campaign_type,
  TRIM(ads.ad_group_id) AS ad_group_id,
  TRIM(ads.ad_group_name) AS ad_group_name,
  ads.keyword_id,
  TRIM(ads.keyword) AS keyword,
  TRIM(ads.keyword_type) AS keyword_type,
  TRIM(ads.match_type) AS match_type,
  TRIM(ads.search_term) AS search_term,
  TRIM(ads.targeting) AS targeting,
  TRIM(ads.keyword_text) AS keyword_text,
  ads.keyword_bid,
  TRIM(ads.ad_keyword_status) AS ad_keyword_status,
  ads.cost,
  ads.spend,
  ads.impressions,
  ads.clicks,
  ads.viewable_impressions,
  ads.viewability_rate,
  ads.view_click_through_rate,
  ads.sales_1d,
  ads.purchases_1d,
  ads.units_sold_clicks_1d,
  ads.attributed_sales_same_sku_1d,
  ads.purchases_same_sku_1d,
  ads.units_sold_same_sku_1d,
  ads.sales_7d,
  ads.purchases_7d,
  ads.units_sold_clicks_7d,
  ads.attributed_sales_same_sku_7d,
  ads.purchases_same_sku_7d,
  ads.units_sold_same_sku_7d,
  ads.units_sold_other_sku_7d,
  ads.sales_other_sku_7d,
  ads.roas_clicks_7d,
  ads.sales_14d,
  ads.purchases_14d,
  ads.units_sold_clicks_14d,
  ads.attributed_sales_same_sku_14d,
  ads.purchases_same_sku_14d,
  ads.units_sold_same_sku_14d,
  ads.roas_clicks_14d,
  ads.sales_30d,
  ads.purchases_30d,
  ads.units_sold_clicks_30d,
  ads.attributed_sales_same_sku_30d,
  ads.purchases_same_sku_30d,
  ads.units_sold_same_sku_30d,
  ads.sales,
  ads.purchases,
  ads.units_sold,
  ads.sales_clicks,
  ads.purchases_clicks,
  ads.video_complete_views,
  ads.video_5_second_views,
  ads.video_5_second_view_rate,
  ads.video_first_quartile_views,
  ads.video_midpoint_views,
  ads.video_third_quartile_views,
  ads.video_unmutes,
  ads.add_to_list,
  ads.add_to_list_from_clicks,
  ads.qualified_borrows,
  ads.qualified_borrows_from_clicks,
  ads.royalty_qualified_borrows,
  ads.royalty_qualified_borrows_from_clicks,
  ads.kindle_edition_normalized_pages_read_14d,
  ads.kindle_edition_normalized_pages_royalties_14d,
  ads.campaign_budget_amount,
  TRIM(ads.campaign_budget_type) AS campaign_budget_type,
  TRIM(ads.campaign_status) AS campaign_status,
  TRIM(ads.cost_type) AS cost_type,
  TRIM(ads.report_period) AS report_period,
  ads.updated_at,
  TRIM(ads.division) AS division,
  TRIM(ads.product) AS product,
  TRIM(ads.campaign_name_cleaned) AS campaign_name_cleaned,
  TRIM(ads.campaign_type_cleaned) AS campaign_type_cleaned,
  TRIM(ads.budget) AS budget,
  TRIM(ads.format) AS format,
  TRIM(ads.ad_type) AS ad_type,
  ads._processed_at,
  TRIM(ads.market) AS market,
  TRIM(ads.company_code) AS company_code,
  ads.date_currency,
  ads.exchange_rate,
  ads.cost_local,
  ads.spend_local,
  ads.campaign_budget_local,
  ads.cost_eur,
  ads.spend_eur,
  ads.campaign_budget_eur
FROM
  ${ref("amazon_ads_search_terms_enriched")} AS ads
LEFT JOIN
  ${ref("dim_countries")} AS c
  ON (TRIM(ads.country_code) = TRIM(c.country_code) OR (TRIM(ads.country_code) = 'UK' AND TRIM(c.country_code) = 'GB'))
  AND c.language_code = 'E'
