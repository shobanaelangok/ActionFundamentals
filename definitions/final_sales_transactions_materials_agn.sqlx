config {
  type: "table",
  schema: "dataform",
  tags: ["auto-cleaning"],
  description: "Final consolidated sales transactions enriched with material master details and AGN product hierarchy levels.",
  columns: {
    sales_document_id: "Sales order document identifier.",
    sales_document_type: "Categorization representing different types of sales transactions.",
    sales_document_item: "Line item position within the sales document.",
    sales_invoice_document_id: "Unique invoice reference identifier.",
    material_id: "Unique identifier for the material / product.",
    material_warranty: "Material number relevant for warranty services.",
    sap_customer_account_number: "Customer account number in SAP.",
    country_code: "ISO 3166-1 alpha-2 country code.",
    customer_group_code: "Customer group code.",
    customer_group: "Customer group descriptive name.",
    customer_class_code: "Customer classification code.",
    customer_class: "Customer classification name.",
    industry_code: "Industry classification code.",
    intercompany_sale_code: "Flag indicating whether transaction is intercompany (0, 1, or 2).",
    sales_local_key_account_code: "Local Key Account code.",
    ship_to_party_code: "Delivery recipient customer number.",
    sales_distribution_channel_code: "Distribution channel code.",
    sales_distribution_channel: "Distribution channel descriptive name.",
    sales_office_code: "Sales office identifier code.",
    sales_office: "Sales office name.",
    sales_district_code: "Sales district code.",
    sales_district: "Sales district name.",
    sales_organisation_code: "Sales organization unit code.",
    sales_profit_center_code: "Profit center identifier code.",
    salesman_revenue_code: "Salesman partner revenue code.",
    salesman_commission_code: "Salesman partner commission code.",
    order_reason_code: "Order reason code.",
    order_reason: "Order reason description.",
    order_type_code: "Order type categorization code.",
    sales_billing_type_code: "Billing document type code.",
    sales_billing_type: "Billing document type description.",
    sales_calculation_type_code: "Pricing calculation type code.",
    sales_channel_code_cm2: "Sales channel code for CM2 reporting.",
    sales_channel_cm2: "Sales channel name for CM2 reporting.",
    currency__local: "Local currency code.",
    sales_quantity: "Position quantity in sales units.",
    gross_sales: "Gross sales value in EUR.",
    gross_sales_before: "Gross sales value before rebate in EUR.",
    total_sales: "Total sales value in EUR.",
    gross_margin: "Gross margin value in EUR.",
    contribution_margin_1: "Contribution margin 1 (CM1) in EUR.",
    contribution_margin_2: "Contribution margin 2 (CM2) in EUR.",
    sales_after_discount: "Sales value after direct discounts in EUR.",
    list_price: "List price according to official price list in EUR.",
    gross_sales__local: "Gross sales in local currency.",
    gross_sales_before__local: "Gross sales before rebate in local currency.",
    total_sales__local: "Total sales in local currency.",
    gross_margin__local: "Gross margin in local currency.",
    contribution_margin_1__local: "Contribution margin 1 in local currency.",
    contribution_margin_2__local: "Contribution margin 2 in local currency.",
    sales_after_discount__local: "Sales after discount in local currency.",
    list_price__local: "List price in local currency.",
    ordered_date: "Date of order creation in SAP SD.",
    ordered_month: "Month of order creation in SAP SD.",
    desired_delivery_date: "Requested delivery date in sales order header.",
    company_code: "Company code identifier.",
    material_number: "Human-readable material catalog number from dim_materials.",
    material_name: "Material description / product name from dim_materials.",
    agn_code: "Three-digit AGN hierarchy node code.",
    division_agn: "Division code associated with the AGN hierarchy.",
    material_type_code: "Material type code (e.g. ZOTH, ZGRP, ZMAC).",
    material_group_code: "Material group code.",
    cross_plant_material_status_code: "Cross-plant material lifecycle status.",
    turnover_key_code: "Material turnover key code.",
    turnover_key: "Material turnover key description.",
    material_created_date: "Creation date of the material master record.",
    agn_level_1: "Level 1 of AGN product hierarchy (e.g., TOTAL).",
    agn_level_2: "Level 2 of AGN product hierarchy (e.g., PROFESSIONAL, CONSUMER).",
    agn_level_3: "Level 3 of AGN product hierarchy.",
    agn_level_4: "Level 4 of AGN product hierarchy (product groups).",
    agn_level_5: "Level 5 of AGN product hierarchy (product subgroups).",
    agn_level_6: "Level 6 of AGN product hierarchy (machine series/models).",
    agn_level_7: "Level 7 of AGN product hierarchy."
  },
  metadata: {
    overview: "This table provides consolidated sales transaction facts enriched with material master attributes and AGN 7-level product category hierarchy.",
    extraProperties: {
      generic: {
        type: "fact table",
        system: "sales"
      }
    }
  }
}

SELECT
  TRIM(fct.sales_document_id) AS sales_document_id,
  TRIM(fct.sales_document_type) AS sales_document_type,
  TRIM(fct.sales_document_item) AS sales_document_item,
  TRIM(fct.sales_invoice_document_id) AS sales_invoice_document_id,
  TRIM(fct.material_id) AS material_id,
  TRIM(fct.material_warranty) AS material_warranty,
  TRIM(fct.sap_customer_account_number) AS sap_customer_account_number,
  TRIM(fct.country_code) AS country_code,
  TRIM(fct.customer_group_code) AS customer_group_code,
  TRIM(fct.customer_group) AS customer_group,
  TRIM(fct.customer_class_code) AS customer_class_code,
  TRIM(fct.customer_class) AS customer_class,
  TRIM(fct.industry_code) AS industry_code,
  TRIM(fct.intercompany_sale_code) AS intercompany_sale_code,
  TRIM(fct.sales_local_key_account_code) AS sales_local_key_account_code,
  TRIM(fct.ship_to_party_code) AS ship_to_party_code,
  TRIM(fct.sales_distribution_channel_code) AS sales_distribution_channel_code,
  TRIM(fct.sales_distribution_channel) AS sales_distribution_channel,
  TRIM(fct.sales_office_code) AS sales_office_code,
  TRIM(fct.sales_office) AS sales_office,
  TRIM(fct.sales_district_code) AS sales_district_code,
  TRIM(fct.sales_district) AS sales_district,
  TRIM(fct.sales_organisation_code) AS sales_organisation_code,
  TRIM(fct.sales_profit_center_code) AS sales_profit_center_code,
  TRIM(fct.salesman_revenue_code) AS salesman_revenue_code,
  TRIM(fct.salesman_commission_code) AS salesman_commission_code,
  TRIM(fct.order_reason_code) AS order_reason_code,
  TRIM(fct.order_reason) AS order_reason,
  TRIM(fct.order_type_code) AS order_type_code,
  TRIM(fct.sales_billing_type_code) AS sales_billing_type_code,
  TRIM(fct.sales_billing_type) AS sales_billing_type,
  TRIM(fct.sales_calculation_type_code) AS sales_calculation_type_code,
  TRIM(fct.sales_channel_code_cm2) AS sales_channel_code_cm2,
  TRIM(fct.sales_channel_cm2) AS sales_channel_cm2,
  TRIM(fct.currency__local) AS currency__local,
  fct.sales_quantity,
  fct.gross_sales,
  fct.gross_sales_before,
  fct.total_sales,
  fct.gross_margin,
  fct.contribution_margin_1,
  fct.contribution_margin_2,
  fct.sales_after_discount,
  fct.list_price,
  fct.gross_sales__local,
  fct.gross_sales_before__local,
  fct.total_sales__local,
  fct.gross_margin__local,
  fct.contribution_margin_1__local,
  fct.contribution_margin_2__local,
  fct.sales_after_discount__local,
  fct.list_price__local,
  fct.ordered_date,
  fct.ordered_month,
  fct.desired_delivery_date,
  TRIM(fct.company_code) AS company_code,
  TRIM(mat.material_number) AS material_number,
  TRIM(mat.material) AS material_name,
  COALESCE(TRIM(mat.agn_code), TRIM(agn.agn_code)) AS agn_code,
  TRIM(mat.division_agn) AS division_agn,
  TRIM(mat.material_type_code) AS material_type_code,
  TRIM(mat.material_group_code) AS material_group_code,
  TRIM(mat.cross_plant_material_status_code) AS cross_plant_material_status_code,
  TRIM(mat.turnover_key_code) AS turnover_key_code,
  TRIM(mat.turnover_key) AS turnover_key,
  mat.created_date AS material_created_date,
  TRIM(agn.level_1) AS agn_level_1,
  TRIM(agn.level_2) AS agn_level_2,
  TRIM(agn.level_3) AS agn_level_3,
  TRIM(agn.level_4) AS agn_level_4,
  TRIM(agn.level_5) AS agn_level_5,
  TRIM(agn.level_6) AS agn_level_6,
  TRIM(agn.level_7) AS agn_level_7
FROM
  ${ref("serving", "fct_sales_transactions")} AS fct
LEFT JOIN
  ${ref("serving", "dim_materials")} AS mat
  ON TRIM(fct.material_id) = TRIM(mat.material_id)
LEFT JOIN
  ${ref("serving", "hier_agn_act")} AS agn
  ON TRIM(mat.agn_code) = TRIM(agn.agn_code)
